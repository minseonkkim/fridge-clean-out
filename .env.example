# 이 파일을 .env.local로 복사하고 값을 채운다. .env.local은 커밋하지 않는다.

# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 새 프로젝트는 publishable key(sb_publishable_...), 기존 프로젝트는 anon key를 넣는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Sentry. DSN을 비워 두면 Sentry가 꺼진다.
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (선택, Vercel 환경 변수에만 넣는다)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
